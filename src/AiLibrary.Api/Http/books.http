###############################################################################
# Catalog API tests — proves the library domain is more than a chat persona.
# Start API first: dotnet run --project src/AiLibrary.Api --launch-profile http
###############################################################################

@baseUrl = http://localhost:5243

### List full catalog
GET {{baseUrl}}/api/books
Accept: application/json

### Search by text
GET {{baseUrl}}/api/books?q=mystery
Accept: application/json

### Filter by genre
GET {{baseUrl}}/api/books?genre=Fantasy
Accept: application/json

### Get one book
GET {{baseUrl}}/api/books/hobbit
Accept: application/json

### Missing book → 404
GET {{baseUrl}}/api/books/not-a-real-id
Accept: application/json

### Health check
GET {{baseUrl}}/health
