###############################################################################
# Catalog API tests — proves the library domain is more than a chat persona.
# Start API first: dotnet run --project src/AiLibrary.Api --launch-profile http
###############################################################################

@baseUrl = http://localhost:5243

### List full catalog
GET {{baseUrl}}/api/books
Accept: application/json

### Search by text
GET {{baseUrl}}/api/books?q=mystery
Accept: application/json

### Filter by genre
GET {{baseUrl}}/api/books?genre=Fantasy
Accept: application/json

### Get one book (The Hobbit seed id)
GET {{baseUrl}}/api/books/11111111-1111-1111-1111-111111111101
Accept: application/json

### Missing book → 404
GET {{baseUrl}}/api/books/99999999-9999-9999-9999-999999999999
Accept: application/json

### Health check
GET {{baseUrl}}/health
